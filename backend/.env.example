# Local development settings for the API. Copy to backend/.env.
# Production values live in /opt/danamo/.env on the server (see deploy/.env.example).
DATABASE_URL=postgresql+asyncpg://danamo:devpassword@localhost:5432/danamo_dev
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://admin.localhost:3000
COOKIE_SECURE=false
ADMIN_COOKIE_SAMESITE=strict

# Leave empty to skip sending email locally (sends are logged as skipped).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@danamotech.co.ke
ADMIN_NOTIFICATION_EMAIL=hello@danamotech.co.ke
