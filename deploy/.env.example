# Copy to /opt/danamo/.env on the VPS, then: chmod 600 .env
# Never commit the real file.

# --- Images ---
IMAGE_TAG=latest

# --- Database (generate with: openssl rand -hex 32) ---
POSTGRES_PASSWORD=change-me

# --- Backend app settings ---
FRONTEND_ORIGIN=https://danamotech.co.ke
FRONTEND_URL=https://danamotech.co.ke
COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=lax

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@danamotech.co.ke
ADMIN_NOTIFICATION_EMAIL=hello@danamotech.co.ke
