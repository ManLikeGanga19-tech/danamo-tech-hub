# ── DANAMO TECH ────────────────────────────────────────────────
# Source of truth: /opt/caddy-sites/danamo.caddy. Appended to the shared
# /opt/shulehq/Caddyfile and re-applied by danamo-guard.sh when a ShuleHQ
# deploy wipes it (same pattern as the other tenants).
# Upstreams are reached by container name over danamo-edge-net.
# TLS: automatic HTTP-01 (danamotech.co.ke DNS @ Cloudflare, DNS-only).

(danamo_headers) {
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}
}

danamotech.co.ke {
	import danamo_headers
	reverse_proxy danamo-frontend:3000
}

www.danamotech.co.ke {
	redir https://danamotech.co.ke{uri} permanent
}

admin.danamotech.co.ke {
	import danamo_headers
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy danamo-frontend:3000
}

api.danamotech.co.ke {
	import danamo_headers
	# The admin API is only reachable through the admin console's own
	# server-side proxy (frontend container -> backend on the private Docker
	# network), never directly from the internet.
	@admin_api path /api/v1/admin /api/v1/admin/*
	respond @admin_api 404
	reverse_proxy danamo-backend:8000
}
